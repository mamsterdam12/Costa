generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Recursive region tree: Spain -> Costa del Sol -> Marbella -> Marbesa, etc.
// Every touristic place gets its own slug/page, so the platform feels local
// per region even though it's one shared database.
model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl")
  country   String   @default("ES")
  latitude  Float?
  longitude Float?

  parentId String?
  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[] @relation("RegionHierarchy")

  events    Event[]
  createdAt DateTime @default(now())
}

// Flat-with-optional-parent category tree.
model EventCategory {
  id           String @id @default(cuid())
  slug         String @unique
  name         String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl")

  parentId String?
  parent   EventCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EventCategory[] @relation("CategoryHierarchy")

  events Event[]
}

// Minimal stub for a later stage: real auth, profiles, roles etc. aren't
// built yet, but Event.createdByUserId needs something to point at now,
// since members will eventually be able to submit their own events (not
// just the seed script / a future scraper).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  createdEvents Event[] @relation("EventCreatedBy")
}

// A business or person that runs events. A Business elsewhere in the
// platform can double as an Organizer (see concept doc §13); kept standalone
// here since the wider Business model doesn't exist yet. Not translated:
// organizer names are proper nouns.
model Organizer {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  website String?
  claimed Boolean @default(false)

  events    Event[]
  createdAt DateTime @default(now())
}

enum EventStatus {
  DRAFT // found by a script or added manually, awaiting review
  PUBLISHED
  ARCHIVED
}

// One visible occurrence of an event. `recurrenceRule` is descriptive
// metadata for now (e.g. "WEEKLY;BYDAY=SU") describing how it repeats;
// splitting this into full Organizer/EventSeries/EventInstance objects
// (per the concept doc) is a later step once recurring events need to be
// managed without re-entering every occurrence by hand.
model Event {
  id          String @id @default(cuid())
  slug        String @unique
  title       String // canonical text, in `sourceLocale` below
  description String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl") // language this event was authored/found in

  startsAt       DateTime
  endsAt         DateTime?
  recurrenceRule String?

  venueName String?
  address   String?
  latitude  Float?
  longitude Float?

  // Object key in the "costa-media" bucket (e.g. "events/<slug>.png"),
  // generated lazily and cached the same way translations are -- see
  // src/lib/imageGeneration.ts. Served through /api/images/[...key]
  // since Railway buckets have no public URL mode.
  imageKey String?

  region   Region @relation(fields: [regionId], references: [id])
  regionId String

  category   EventCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  organizer   Organizer? @relation(fields: [organizerId], references: [id])
  organizerId String?

  status EventStatus @default(PUBLISHED)

  // Null for events from the seed script or a future scraper; set when a
  // member submits their own event.
  createdByUser   User?   @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?

  // Discovery/ingestion metadata, so a future script can upsert safely
  // instead of creating duplicates, and so stale finds can be flagged.
  sourceName String? // e.g. "manual", "eventbrite", "tevienes"
  sourceUrl  String?
  externalId String? // id/hash from the source
  lastSeenAt DateTime? // last time a discovery run confirmed this still exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceName, externalId])
  @@index([regionId, startsAt])
  @@index([categoryId])
}

enum TranslationSource {
  MACHINE
  HUMAN
}

// Generic, cached translation for ANY translatable field on ANY entity in
// the platform -- one shared mechanism for Events today, and for
// Businesses, Marketplace listings, Announcements, forum posts, etc. as
// those modules get built, instead of a bespoke translation table per
// module. A row is created lazily the first time a locale is requested for
// a given (entityType, entityId, field); `source: HUMAN` protects
// curated/reviewed text from being overwritten by a machine translation.
model Translation {
  id         String            @id @default(cuid())
  entityType String // e.g. "event", "region", "eventCategory", later "business", "listing", ...
  entityId   String
  field      String // e.g. "title", "description", "name"
  locale     String
  text       String
  source     TranslationSource @default(MACHINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
}
