generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Recursive region tree: Spain -> Costa del Sol -> Marbella -> Marbesa, etc.
// Every touristic place gets its own slug/page, so the platform feels local
// per region even though it's one shared database.
model Region {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl")
  country   String   @default("ES")
  latitude  Float?
  longitude Float?

  parentId String?
  parent   Region?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children Region[] @relation("RegionHierarchy")

  events      Event[]
  sources     Source[]
  communities Community[]
  createdAt   DateTime    @default(now())
}

// Flat-with-optional-parent category tree.
model EventCategory {
  id           String @id @default(cuid())
  slug         String @unique
  name         String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl")

  parentId String?
  parent   EventCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EventCategory[] @relation("CategoryHierarchy")

  events Event[]
}

// Minimal stub for a later stage: real auth, profiles, roles etc. aren't
// built yet, but Event.createdByUserId needs something to point at now,
// since members will eventually be able to submit their own events (not
// just the seed script / a future scraper).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  createdEvents Event[] @relation("EventCreatedBy")
}

// The residential/legal entity (urbanización, Comunidad de Propietarios)
// from the original concept doc -- distinct from Region, which is purely
// geographic. Recursive for the same reason Region is: one urbanización
// can be several communities, sub-communities, phases, etc. Optional on
// Event: most events belong to a place (Region) without being tied to one
// specific residential community.
model Community {
  id      String  @id @default(cuid())
  name    String
  claimed Boolean @default(false) // false = still "UNCLAIMED" per the concept doc

  region   Region @relation(fields: [regionId], references: [id])
  regionId String

  parentId String?
  parent   Community?  @relation("CommunityHierarchy", fields: [parentId], references: [id])
  children Community[] @relation("CommunityHierarchy")

  events    Event[]
  createdAt DateTime @default(now())
}

// Simple key/value store for platform-wide toggles -- currently just the
// manual translation circuit breaker (src/lib/translation.ts), switched
// from the /dashboard page. Deliberately manual, not auto-recovering: we
// don't want it silently hammering the OpenAI API on a retry schedule
// while credits are out.
model Setting {
  key   String @id
  value String
}

// A business or person that runs events. A Business elsewhere in the
// platform can double as an Organizer (see concept doc §13); kept standalone
// here since the wider Business model doesn't exist yet. Not translated:
// organizer names are proper nouns.
model Organizer {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  website String?
  claimed Boolean @default(false)

  events    Event[]
  createdAt DateTime @default(now())
}

enum EventStatus {
  DRAFT // found by a script or added manually, awaiting review
  PUBLISHED
  ARCHIVED
}

enum CostType {
  FREE
  PAID
  UNKNOWN
}

enum SourceDiscoveryMethod {
  AI // found by a periodic AI-assisted discovery run
  MANUAL // added by hand (e.g. this seed)
}

enum SourcePurpose {
  EVENTS // scraped directly for events, by a regular per-source script
  SOURCE_DISCOVERY // an aggregator (e.g. Eventbrite's own site) the AI discovery
  // run searches for new EVENTS sources; never scraped for events itself
}

// Registry of places to scrape events from -- "the source database" a
// regular scraper script reads. Two separate mechanisms populate/use this:
//
// - Periodic, AI-assisted discovery runs (infrequent, e.g. monthly) look
//   for event sources this region doesn't have yet and INSERT new rows
//   here with discoveredBy: AI and active: false, pending review. They
//   never touch Event rows themselves.
// - Regular scraping (frequent, e.g. daily/hourly) is plain deterministic
//   script code, one parser per `sourceType`, that reads every `active`
//   Source and upserts the events it finds via Event's own
//   (sourceName, externalId) unique constraint. That upsert always
//   updates the *same* Event row (same id) for a given source event, so
//   later per-event data that hangs off that id -- e.g. members marking
//   "I'm going" / "I was there", not built yet -- is never disturbed by
//   a routine re-scrape.
model Source {
  id         String @id @default(cuid())
  name       String
  url        String @unique
  sourceType String // e.g. "eventbrite", "ics-calendar", "html-listing" -- selects which parser the scraper script uses

  region   Region? @relation(fields: [regionId], references: [id])
  regionId String?

  purpose      SourcePurpose         @default(EVENTS)
  active       Boolean               @default(true)
  discoveredBy SourceDiscoveryMethod @default(MANUAL)
  notes        String? // e.g. the AI discovery run's reasoning for suggesting this source

  // Fase 1 error handling: a failing scraper script marks its Source here.
  // An AI agent (or a person, via /dashboard) reviews flagged sources and
  // can deactivate them or clear the flag -- it does not edit scraper code
  // (that's a later, separate phase).
  lastScrapedAt    DateTime?
  lastScrapeStatus String? // e.g. "success", "failed: 404"
  needsReview      Boolean   @default(false)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The last copy of a page we successfully fetched, so scraping does not
// mean hitting the origin again for every parse. Three jobs:
//  - re-running a scraper (or fixing its parser) costs no request at all;
//  - a source that refuses us -- SiteGround challenges Railway's egress
//    IPs on sight -- degrades to "working from the copy of <date>"
//    instead of yielding nothing;
//  - conditional requests (etag/last-modified) let the origin answer 304
//    and send no body when nothing changed.
model PageSnapshot {
  id       String @id @default(cuid())
  url      String @unique // the URL we requested
  finalUrl String // where we ended up after redirects
  status   Int

  contentType  String  @default("")
  body         String // raw response text
  bytes        Int     @default(0)
  etag         String?
  lastModified String?

  fetchedAt     DateTime  @default(now()) // when `body` was last confirmed current
  lastAttemptAt DateTime  @default(now())
  lastError     String? // why the most recent attempt failed, if it did
  blockedAt     DateTime? // last time the origin served a bot challenge

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One visible occurrence of an event. `recurrenceRule` is descriptive
// metadata for now (e.g. "WEEKLY;BYDAY=SU") describing how it repeats;
// splitting this into full Organizer/EventSeries/EventInstance objects
// (per the concept doc) is a later step once recurring events need to be
// managed without re-entering every occurrence by hand.
model Event {
  id          String @id @default(cuid())
  slug        String @unique
  title       String // canonical text, in `sourceLocale` below
  description String // canonical text, in `sourceLocale` below
  sourceLocale String @default("nl") // language this event was authored/found in

  startsAt       DateTime
  // False when the source gave a date but no hour: startsAt is then
  // midnight local, which is a placeholder, not a claim that the event
  // starts at midnight. Pages show the date alone in that case.
  startTimeKnown Boolean @default(true)
  endsAt         DateTime?
  recurrenceRule String?

  venueName String?
  address   String?
  latitude  Float?
  longitude Float?

  // Free text on purpose (not a strict decimal): real-world pricing is
  // often tiered ("€5 adults, free for children") and doesn't fit a
  // single number. costType is what's filterable ("show only free events").
  costType   CostType @default(UNKNOWN)
  costAmount String?

  // Object key in the "costa-media" bucket (e.g. "events/<slug>.png"),
  // generated lazily and cached the same way translations are -- see
  // src/lib/imageGeneration.ts. Served through /api/images/[...key]
  // since Railway buckets have no public URL mode.
  imageKey String?

  // Where imageKey was copied from, when it came from the source rather
  // than being generated: the event's own poster, as the source
  // published it. Null means the picture is ours (or there is none).
  imageUrl String?

  // Dimensions of the stored picture. Recorded because a source answers
  // with a valid image for events that have none -- a spacer, an icon --
  // and only its size on screen tells them apart.
  imageWidth  Int?
  imageHeight Int?

  region   Region @relation(fields: [regionId], references: [id])
  regionId String

  // Optional: the specific residential community this event belongs to,
  // distinct from Region (geographic). Most events won't have one.
  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?

  category   EventCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  organizer   Organizer? @relation(fields: [organizerId], references: [id])
  organizerId String?

  status EventStatus @default(PUBLISHED)

  // Cross-source duplicate detection marks here, never deletes or merges:
  // both rows keep existing (and keep their own id), so any per-event data
  // already attached to the duplicate (e.g. future "I'm going" marks)
  // stays valid. Public pages filter out events where this is set, and
  // attribute their engagement to the canonical event instead.
  duplicateOf   Event?  @relation("EventDuplicate", fields: [duplicateOfId], references: [id])
  duplicateOfId String?
  duplicates    Event[] @relation("EventDuplicate")

  // Null for events from the seed script or a future scraper; set when a
  // member submits their own event.
  createdByUser   User?   @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  createdByUserId String?

  // Discovery/ingestion metadata, so a future script can upsert safely
  // instead of creating duplicates, and so stale finds can be flagged.
  // `source`/`sourceId` links to the Source registry once that source is
  // registered there; `sourceName`/`sourceUrl` stay as free-text fields
  // (also used by hand-entered events like this seed's, which aren't
  // tied to a Source row) and remain what the unique constraint below
  // matches on, so registering a Source later doesn't require touching
  // already-ingested events.
  source     Source? @relation(fields: [sourceId], references: [id])
  sourceId   String?
  sourceName String? // e.g. "manual-research", "eventbrite", "tevienes"
  sourceUrl  String?
  externalId String? // id/hash from the source
  lastSeenAt DateTime? // last time a discovery run confirmed this still exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // startsAt is part of the key so a recurring event (same source, same
  // externalId every week) can't accidentally overwrite last week's row
  // with this week's date -- each occurrence gets matched as its own row.
  @@unique([sourceName, externalId, startsAt])
  @@index([regionId, startsAt])
  @@index([categoryId])
  @@index([communityId])
}

enum TranslationSource {
  MACHINE
  HUMAN
}

// Generic, cached translation for ANY translatable field on ANY entity in
// the platform -- one shared mechanism for Events today, and for
// Businesses, Marketplace listings, Announcements, forum posts, etc. as
// those modules get built, instead of a bespoke translation table per
// module. A row is created lazily the first time a locale is requested for
// a given (entityType, entityId, field); `source: HUMAN` protects
// curated/reviewed text from being overwritten by a machine translation.
model Translation {
  id         String            @id @default(cuid())
  entityType String // e.g. "event", "region", "eventCategory", later "business", "listing", ...
  entityId   String
  field      String // e.g. "title", "description", "name"
  locale     String
  text       String
  source     TranslationSource @default(MACHINE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId, field, locale])
  @@index([entityType, entityId])
}
